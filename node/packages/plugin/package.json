{
  "name": "mineflayer-bridge",
  "version": "0.1.0-alpha.26",
  "description": "Mineflayer plugin that connects bots to the mineflayer-bridge client mod: world-space shapes, HUD, menus, commands, shared objects and extensions, drawn in the player's own client.",
  "keywords": [
    "mineflayer",
    "mineflayer-plugin",
    "minecraft",
    "bot",
    "visualization",
    "debugging",
    "hud",
    "pathfinder",
    "fabric",
    "neoforge"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Pix3lPirat3 and mineflayer-bridge contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pix3lPirat3/mineflayer-bridge.git",
    "directory": "node/packages/plugin"
  },
  "homepage": "https://github.com/Pix3lPirat3/mineflayer-bridge#readme",
  "bugs": {
    "url": "https://github.com/Pix3lPirat3/mineflayer-bridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mineflayer": {
      "types": "./types/mineflayer.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mineflayer-bridge": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@mineflayer-bridge/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "mineflayer": ">=4"
  },
  "peerDependenciesMeta": {
    "mineflayer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mineflayer-bridge/mock-mod": "workspace:*",
    "@types/ws": "^8.5.12"
  }
}
